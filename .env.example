# ─── KSP Crime Intelligence — Docker Compose Environment ──────────────────────
# Copy this to .env and fill in your production values.
# NEVER commit .env to version control with real passwords.

# PostgreSQL
DB_USER=ksp_admin
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
DB_NAME=ksp_crime_intel

# Frontend URL (for CORS — set to your actual domain)
FRONTEND_ORIGIN=https://your-domain.example.com
