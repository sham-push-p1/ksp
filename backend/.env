# ─── KSP Crime Intelligence — Environment Configuration ───────────────────────
# Copy this file and rename to .env for your environment

# AI Backend (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
USE_QUICKML=false

# Server
PORT=3001
NODE_ENV=production

# Frontend Origin (CORS) — Set to your actual production domain
FRONTEND_ORIGIN=https://ksp-intel.karnataka.gov.in

# PostgreSQL (Production) — Override these with real credentials
DB_HOST=db
DB_PORT=5432
DB_USER=ksp_admin
DB_PASSWORD=${DB_PASSWORD:-change_me_in_production}
DB_NAME=ksp_crime_intel
